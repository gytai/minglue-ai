# -------- 应用配置 --------
# 应用运行环境
APP_ENV = 'prod'
# 应用名称
APP_NAME = '明略AI硬件数据管理平台'
# 应用代理路径
APP_ROOT_PATH = '/prod-api'
# 应用主机
APP_HOST = '0.0.0.0'
# 应用端口
APP_PORT = 9099
# 应用版本
APP_VERSION= '2.1.1'
# 应用是否开启热重载
APP_RELOAD = false
# 应用是否开启IP归属区域查询
APP_IP_LOCATION_QUERY = true
# 应用是否允许账号同时登录
APP_SAME_TIME_LOGIN = true

# -------- Jwt配置 --------
# Jwt秘钥
JWT_SECRET_KEY = 'b01c66dc2c58dc6a0aabfe2144256be36226de378bf87f72c0c795dda67f4d55'
# Jwt算法
JWT_ALGORITHM = 'HS256'
# 令牌过期时间
JWT_EXPIRE_MINUTES = 1440
# redis中令牌过期时间
JWT_REDIS_EXPIRE_MINUTES = 30


# -------- 数据库配置 --------
# 数据库类型，可选的有'mysql'、'postgresql'，默认为'mysql'
DB_TYPE = 'mysql'
# 数据库主机
DB_HOST = '127.0.0.1'
# 数据库端口
DB_PORT = 3306
# 数据库用户名
DB_USERNAME = 'root'
# 数据库密码
DB_PASSWORD = 'root'
# 数据库名称
DB_DATABASE = 'dash-fastapi'
# 是否开启sqlalchemy日志
DB_ECHO = true
# 允许溢出连接池大小的最大连接数
DB_MAX_OVERFLOW = 10
# 连接池大小，0表示连接数无限制
DB_POOL_SIZE = 50
# 连接回收时间（单位：秒）
DB_POOL_RECYCLE = 3600
# 连接池中没有线程可用时，最多等待的时间（单位：秒）
DB_POOL_TIMEOUT = 30

# -------- Redis配置 --------
# Redis主机
REDIS_HOST = '127.0.0.1'
# Redis端口
REDIS_PORT = 6379
# Redis用户名
REDIS_USERNAME = ''
# Redis密码
REDIS_PASSWORD = ''
# Redis数据库
REDIS_DATABASE = 2

# 明略设备回调加固签名密钥；厂商文档未定义回调签名，本项只属本系统加固能力。
# 必须保持为空：厂商不签名，贸然开启会让所有真实回调 401。
# 仅当接入网关/反向代理确实在本入口前对原始请求体签名时才可设置（X-Signature /
# X-Callback-Signature = hex(hmac_sha256(secret, 原始请求体))，可带 sha256= 前缀）。
MINGLUE_CALLBACK_SECRET = ''
# 回调同步落库预算（秒）；厂商规定响应超过 3s 即视为失败，默认 2.5s 留出写出余量。
# 超时后回滚业务改动、落一条 process_status='timeout' 的审计记录并返回 503 供厂商重试。
# 置 0 或负值关闭超时保护（仅排障用）。
MINGLUE_CALLBACK_RESPONSE_BUDGET = 2.5
# 厂商时间字段的时区归属：厂商文档未说明 update_time 是否为北京时间（不确定项 U12）。
# 落库口径统一为 UTC naive；不带偏移的墙钟串按本变量换算。留空 = 原样保存。
# 若真实设备确认为北京时间，改为 Asia/Shanghai 即可，无需改代码。
MINGLUE_VENDOR_TIMEZONE = ''

# 明略 AIOT 服务；生产环境请从密钥管理系统注入敏感值
MINGLUE_API_BASE_URL = ''
MINGLUE_API_USERNAME = ''
MINGLUE_API_PASSWORD = ''
MINGLUE_API_AES_KEY = ''
MINGLUE_API_AUTH_SCHEME = 'Bearer'
MINGLUE_API_BATCH_SN_QUERY = true
MINGLUE_API_TIMEOUT = 10
